<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately narrow: no typeViewTextChanged (so typed text never reaches the app), and the
  observed package list is set at runtime to the single vendor app the operator selected.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/guide_service_description"
    android:summary="@string/guide_service_summary"
    android:accessibilityEventTypes="typeViewClicked|typeViewLongClicked|typeViewSelected|typeViewScrolled|typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="50" />
